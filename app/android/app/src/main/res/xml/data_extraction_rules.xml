<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later: the same data for cloud backup and for phone-to-phone transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="FlutterSharedPreferences.xml" />
        <include domain="file" path="app_flutter/TalkRoll Scripts" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="FlutterSharedPreferences.xml" />
        <include domain="file" path="app_flutter/TalkRoll Scripts" />
    </device-transfer>
</data-extraction-rules>
